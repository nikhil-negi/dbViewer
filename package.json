{
  "name": "dbviewer",
  "displayName": "PostgreSQL & ClickHouse Explorer",
  "description": "Browse PostgreSQL and ClickHouse objects, run queries, import DBeaver connections, and debug PL/pgSQL routines via a .NET backend.",
  "version": "0.0.1",
  "publisher": "Nikhil",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbviewer",
          "title": "SQL Explorer",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "dbviewer": [
        {
          "id": "dbExplorer",
          "name": "Connections",
          "icon": "$(database)"
        }
      ]
    },
    "commands": [
      {
        "command": "dbviewer.connect",
        "title": "DBViewer: Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "dbviewer.removeConnection",
        "title": "DBViewer: Remove Connection"
      },
      {
        "command": "dbviewer.refresh",
        "title": "DBViewer: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "dbviewer.runSelectedQuery",
        "title": "DBViewer: Run Query (selection or file)",
        "icon": "$(play)"
      },
      {
        "command": "dbviewer.cancelQuery",
        "title": "DBViewer: Cancel Running Query"
      },
      {
        "command": "dbviewer.selectConnection",
        "title": "DBViewer: Set Default Connection for Unbound Files"
      },
      {
        "command": "dbviewer.debugRoutine",
        "title": "DBViewer: Debug Routine",
        "icon": "$(debug-alt)"
      },
      {
        "command": "dbviewer.runRoutine",
        "title": "DBViewer: Run Routine",
        "icon": "$(play)"
      },
      {
        "command": "dbviewer.importDbeaver",
        "title": "DBViewer: Import Connections from DBeaver",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dbviewer.editCredentials",
        "title": "Edit Connection Credentials"
      },
      {
        "command": "dbviewer.testConnection",
        "title": "DBViewer: Test Connection"
      },
      {
        "command": "dbviewer.setFileConnection",
        "title": "DBViewer: Set Connection for This File",
        "icon": "$(database)"
      },
      {
        "command": "dbviewer.setFileSchema",
        "title": "DBViewer: Set Schema for This File",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "dbviewer.useConnectionForFile",
        "title": "DBViewer: Use This Connection for the Active File"
      },
      {
        "command": "dbviewer.openDefinition",
        "title": "DBViewer: Open Definition"
      },
      {
        "command": "dbviewer.filterExplorer",
        "title": "DBViewer: Filter Explorer",
        "icon": "$(filter)"
      },
      {
        "command": "dbviewer.clearFilter",
        "title": "DBViewer: Clear Explorer Filter",
        "icon": "$(filter-filled)"
      },
      {
        "command": "dbviewer.filterType",
        "title": "DBViewer: Filter — Type Character"
      },
      {
        "command": "dbviewer.filterBackspace",
        "title": "DBViewer: Filter — Delete Character"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbviewer.connect",
          "when": "view == dbExplorer",
          "group": "navigation@1"
        },
        {
          "command": "dbviewer.importDbeaver",
          "when": "view == dbExplorer",
          "group": "navigation@2"
        },
        {
          "command": "dbviewer.filterExplorer",
          "when": "view == dbExplorer",
          "group": "navigation@3"
        },
        {
          "command": "dbviewer.clearFilter",
          "when": "view == dbExplorer && dbviewer.filtered",
          "group": "navigation@4"
        },
        {
          "command": "dbviewer.refresh",
          "when": "view == dbExplorer",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "dbviewer.useConnectionForFile",
          "when": "view == dbExplorer && viewItem == connection",
          "group": "1_context@1"
        },
        {
          "command": "dbviewer.testConnection",
          "when": "view == dbExplorer && viewItem == connection",
          "group": "2_manage@1"
        },
        {
          "command": "dbviewer.setCredentials",
          "when": "view == dbExplorer && viewItem == connection",
          "group": "2_manage@2"
        },
        {
          "command": "dbviewer.removeConnection",
          "when": "view == dbExplorer && viewItem == connection",
          "group": "2_manage@3"
        },
        {
          "command": "dbviewer.runRoutine",
          "when": "view == dbExplorer && viewItem == routine",
          "group": "inline@1"
        },
        {
          "command": "dbviewer.debugRoutine",
          "when": "view == dbExplorer && viewItem == routine",
          "group": "inline@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "dbviewer.runSelectedQuery",
          "when": "editorLangId == sql || resourceScheme == pg-schema"
        }
      ],
      "editor/context": [
        {
          "command": "dbviewer.runSelectedQuery",
          "when": "editorLangId == sql || resourceScheme == pg-schema",
          "group": "dbviewer"
        }
      ],
      "commandPalette": [
        {
          "command": "dbviewer.openDefinition",
          "when": "false"
        },
        {
          "command": "dbviewer.useConnectionForFile",
          "when": "false"
        },
        {
          "command": "dbviewer.filterType",
          "when": "false"
        },
        {
          "command": "dbviewer.filterBackspace",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dbviewer.runSelectedQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && (editorLangId == sql || resourceScheme == pg-schema)"
      },
      {
        "command": "dbviewer.filterType",
        "key": "a",
        "when": "focusedView == dbExplorer",
        "args": "a"
      },
      {
        "command": "dbviewer.filterType",
        "key": "shift+a",
        "when": "focusedView == dbExplorer",
        "args": "a"
      },
