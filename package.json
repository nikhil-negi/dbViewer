    "debuggers": [
      {
        "type": "pgsql",
        "label": "PostgreSQL PL/pgSQL Debugger",
        "languages": [
          "sql"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "connection",
              "routine"
            ],
            "properties": {
              "connection": {
                "type": "string",
                "description": "Connection name (as added in the DBViewer explorer)"
              },
              "routine": {
                "type": "string",
                "description": "Schema-qualified routine name, e.g. public.my_func"
              },
              "args": {
                "type": "array",
                "description": "Argument literals passed to the routine, in order",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "pgsql",
            "request": "launch",
            "name": "Debug PL/pgSQL routine",
            "connection": "my-connection",
            "routine": "public.my_function",
            "args": []
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:ui": "tsc -p ./",
    "build:worker": "dotnet publish worker/DBViewerWorker -c Release -o worker/publish",
    "build": "npm run build:ui && npm run build:worker",
    "package": "vsce package --allow-missing-repository",
    "build-worker": "npm run build:worker",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.0"
  }
}
