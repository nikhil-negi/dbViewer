{
  // Type checking only for the React webviews; esbuild.mjs does the bundling.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": []
  },
  // shared, vscode-free modules from src/ (message protocol, fuzzy matcher) come in via imports
  "include": ["."]
}
